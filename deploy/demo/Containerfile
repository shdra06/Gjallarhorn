# The full demo: Bifrost + Gjallarhorn, the operator console, the demo company's agents and tools,
# a mock model (with a scripted stand-in for the co-pilot's LLM), the attack lab and its traffic
# driver, in one container.
#
#   podman build -t gjallarhorn-bifrost -f deploy/Containerfile .
#   podman build -t gjallarhorn-demo -f deploy/demo/Containerfile .
#   bash deploy/demo/run-console.sh     (the console, live)
#   bash deploy/demo/run-lab.sh         (the attack lab and co-pilot drill)

# The image built from deploy/Containerfile. Podman calls it localhost/gjallarhorn-bifrost;
# with Docker, pass --build-arg BASE=gjallarhorn-bifrost:latest (demo.sh does this for you).
ARG BASE=localhost/gjallarhorn-bifrost:latest

FROM golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
ENV CGO_ENABLED=0
COPY demo/go.mod demo/go.sum /src/demo/
RUN cd /src/demo && go mod download
COPY demo/ /src/demo/
RUN cd /src/demo && go build -trimpath -o /out/demoworld ./cmd/demoworld \
 && go build -trimpath -o /out/attacklab ./cmd/attacklab \
 && go build -trimpath -o /out/mockmodel ./cmd/mockmodel \
 && go build -trimpath -o /out/measure ./cmd/measure

FROM node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS console
WORKDIR /src/console
COPY console/package.json console/package-lock.json console/.npmrc ./
RUN npm ci --no-audit --no-fund
COPY console/ ./
RUN npm run build

FROM ${BASE}
COPY --from=build /out/ /app/
COPY --from=console /src/console/dist/ /app/console/
COPY --chown=bifrost:bifrost deploy/demo/config.json /app/data/config.json
# Local pricing data, so Bifrost starts without internet access (see deploy/offline/README.md).
COPY deploy/offline/ /app/offline/
COPY deploy/demo/run.sh /app/run.sh
# Bifrost's own dashboard login, for the demo only (printed by run-console.sh). Override with -e.
ENV BIFROST_ADMIN_USERNAME=admin BIFROST_ADMIN_PASSWORD=demo-bifrost-password
EXPOSE 8080 8787 9100
ENTRYPOINT ["/bin/sh", "/app/run.sh"]
